# Sessão JWT (obrigatório em produção)
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# URIs de redirect autorizadas (exemplos):
#   http://localhost:3000/api/auth/google/callback
#   https://crime-mania.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional se a origem for inferida da requisição:
# GOOGLE_REDIRECT_URI=

# Exibir botão "Continuar com Google" (use o mesmo Client ID ou true)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_AUTH=true

# Versão de sessão (invalidar tokens antigos)
# CM_SESSION_VERSION=3

# Feed RSS oficial — catálogo com ISR (padrão: Anchor Crime Mania)
# PODCAST_RSS_URL=https://anchor.fm/s/43210668/podcast/rss
# EPISODE_REVALIDATE_SECONDS=1800

# POST /api/admin/sync-episodes — Authorization: Bearer <secret>
# CM_ADMIN_SYNC_SECRET=

# Contas de QA (Preview/local — não commitar senhas)
# ALLOW_TEST_USERS=true
# QA_FREE_EMAIL=
# QA_FREE_PASSWORD=
# QA_TIER1_EMAIL=
# QA_TIER1_PASSWORD=
# QA_TIER2_EMAIL=
# QA_TIER2_PASSWORD=
# Opcional: alterar tier no seed (none | tier1 | tier2)
# QA_FREE_TIER=none
# QA_TIER1_TIER=tier1
# QA_TIER2_TIER=tier2
# Vercel/serverless: após seed local, npm run seed:test-members -- --emit-vercel-json → CM_TEST_USERS_JSON
# ALLOW_PLAN_SIMULATION=true  # só dev — habilita /api/subscribe simulado (contas normais)
# CM_USERS_STORE_PATH=private/data/users-store.json
