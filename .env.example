# Sessão JWT (obrigatório em produção)
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# URIs de redirect autorizadas (exemplos):
#   http://localhost:3000/api/auth/google/callback
#   https://crime-mania.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional se a origem for inferida da requisição:
# GOOGLE_REDIRECT_URI=

# Exibir botão "Continuar com Google" (use o mesmo Client ID ou true)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_AUTH=true

# Versão de sessão (invalidar tokens antigos)
# CM_SESSION_VERSION=3

# Feed RSS oficial — catálogo com ISR (padrão: Anchor Crime Mania)
# PODCAST_RSS_URL=https://anchor.fm/s/43210668/podcast/rss
# EPISODE_REVALIDATE_SECONDS=1800

# POST /api/admin/sync-episodes — Authorization: Bearer <secret>
# CM_ADMIN_SYNC_SECRET=

# Contas de QA (local/Preview/Production — não commitar senhas; Production: ALLOW_TEST_USERS + CM_TEST_USERS_JSON)
# ALLOW_TEST_USERS=true
# QA_FREE_EMAIL=
# QA_FREE_PASSWORD=
# QA_TIER1_EMAIL=
# QA_TIER1_PASSWORD=
# QA_TIER2_EMAIL=
# QA_TIER2_PASSWORD=
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASSWORD=
# Opcional: alterar tier no seed (none | tier1 | tier2)
# QA_FREE_TIER=none
# QA_TIER1_TIER=tier1
# QA_TIER2_TIER=tier2
# Vercel/serverless: após seed local, npm run seed:test-members -- --emit-vercel-json → CM_TEST_USERS_JSON
# Dossiês: npm run dossier:process -- --slug=familia-banfield --publish (worker local; artefatos em private/dossiers/processed/)
# Leitor HTML (padrão): npm run dossier:document-migrate && npm run dossier:bootstrap-banfield-html
# Rollback recortes PDF: DOSSIER_LEGACY_CROP_READER=1
# ALLOW_PLAN_SIMULATION=true  # só dev — habilita /api/subscribe simulado (contas normais)

# Billing Asaas (servidor desligado por padrão)
# BILLING_ENABLED=false
# NEXT_PUBLIC_BILLING_ENABLED=false
# BILLING_QA_TEST_MODE=false  # simulação sem cobrança, só para IDs fixos de QA
# BILLING_PROVIDER=asaas
# ASAAS_ENVIRONMENT=sandbox
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# APP_BASE_URL=http://localhost:3000
# CM_USERS_STORE_PATH=private/data/users-store.json

# Comunidade (Neon Postgres — obrigatório na Vercel)
# POSTGRES_URL=
# CM_COMMUNITY_STORE_PATH=private/data/community-db.json  # só dev local sem Postgres
# Editorial (dossiê admin + moderação comunidade) — lista única, vírgulas
# CM_EDITORIAL_USER_IDS=uuid1,uuid2
# Legado (fallback se CM_EDITORIAL_USER_IDS vazio): união das duas listas abaixo
# CM_COMMUNITY_MODERATOR_IDS=uuid1,uuid2

# Dossiês — Vercel Blob privado + Postgres (obrigatório upload/worker na Vercel)
# BLOB_READ_WRITE_TOKEN=
# CM_DOSSIER_ADMIN_IDS=uuid1,uuid2  # legado — preferir CM_EDITORIAL_USER_IDS
# CM_DOSSIER_WORKER_SECRET=  # Bearer para POST /api/admin/dossier/worker (GitHub Actions)
# CM_DOSSIER_MEDIA_SECRET=    # HMAC opcional para URLs de bloco (?sig= expira em 5 min)
# CM_DOSSIER_REQUIRE_MEDIA_SIG=0
# GitHub secrets: POSTGRES_URL, BLOB_READ_WRITE_TOKEN
# Preview protegido: Protection Bypass for Automation → VERCEL_AUTOMATION_BYPASS_SECRET (CI/qa:community-preview)
